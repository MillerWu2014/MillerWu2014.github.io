<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$title · Miller Wu</title>
  <link rel="stylesheet" href="../style.css">
  <link rel="stylesheet" href="../reader.css">
  <script src="../reader.js" defer></script>
  <script src="../header.js" defer></script>
</head>
<body>
  <header class="top">
    <a class="brand" href="../">MILLER WU <span>/ NOTES</span></a>
    $navigation
  </header>
  <div class="reading-layout">
    <aside class="reading-sidebar category-sidebar" aria-label="同分类文章">
      <details class="sidebar-panel" open>
        <summary>分类文章</summary>
        <nav class="category-posts" aria-label="分类文章列表">$category_navigation</nav>
      </details>
    </aside>
    <main class="reader">
    <div class="article-topbar">
      <a class="jump" href="../#writing">← 文章索引</a>
      <div class="markdown-actions" aria-label="Markdown 操作">
        <button type="button" id="copy-markdown" hidden>复制 Markdown</button>
        <a id="download-markdown" href="$markdown_url" download="$markdown_filename">下载 Markdown ↓</a>
      </div>
    </div>
    <p class="markdown-feedback" id="markdown-feedback" role="status" hidden></p>
    <p id="status" role="status" hidden></p>
    <article>
      <header>
        <p class="count"><time datetime="$date">$date</time></p>
        <h1>$title</h1>
      </header>
      <div class="prose" id="body">$content</div>
    </article>
  </main>
    <aside class="reading-sidebar toc-sidebar" aria-label="文章目录">
      <details id="outline" class="sidebar-panel" open hidden><summary>文章目录</summary><nav aria-label="文章目录"></nav></details>
    </aside>
  </div>
</body>
</html>
